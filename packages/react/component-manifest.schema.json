{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baseui.sh/schema/component-manifest.schema.json",
  "title": "baseui.sh component manifest",
  "type": "object",
  "required": [
    "name",
    "version",
    "radius",
    "themes",
    "categories",
    "iconLibrary"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "baseui.sh"
    },
    "version": {
      "type": "string"
    },
    "radius": {
      "type": "string",
      "const": "4px"
    },
    "themes": {
      "type": "array",
      "items": {
        "enum": [
          "light",
          "dark",
          "system"
        ]
      },
      "uniqueItems": true
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "iconLibrary": {
      "type": "object",
      "required": [
        "name",
        "package",
        "version",
        "semanticIcons",
        "entryPoints"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "Phosphor Icons"
        },
        "package": {
          "type": "string",
          "const": "@phosphor-icons/react"
        },
        "version": {
          "type": "string"
        },
        "semanticIcons": {
          "type": "integer",
          "minimum": 1
        },
        "entryPoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
